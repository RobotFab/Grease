{
  "name": "arduino-grease",
  "displayName": "Arduino Grease",
  "publisher": "RobotFab",
  "version": "1.0.12",
  "description": "Arduino tooling + MCP server for agentic debugging inside VS Code, Cursor, and Antigravity.",
  "releaseNotes": "v1.0.12 — Universal VSIX: removed native binary dependencies (serialport, usb); serial I/O now runs through arduino-cli monitor. Removed clangd dependency — hover is provided by the built-in Grease hover provider. New .ino files created by AI agents are auto-opened in the editor. Panel title removed for a cleaner UI.",
  "main": "dist/extension.js",
  "icon": "icon.png",
  "scripts": {
    "compile": "tsc -p .",
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "lint": "eslint .",
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "keywords": [],
  "author": "Andre Rosendo",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [],
  "contributes": {
    "languages": [
      {
        "id": "arduino",
        "extensions": [
          ".ino"
        ],
        "aliases": [
          "Arduino",
          "arduino"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "arduino",
        "scopeName": "source.arduino",
        "path": "./syntaxes/arduino.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Grease",
        "uiTheme": "vs-dark",
        "path": "./themes/grease-color-theme.json"
      },
      {
        "label": "Graphite",
        "uiTheme": "vs-dark",
        "path": "./themes/graphite-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "arduinoMcp.startSketch",
        "title": "Arduino Grease: Start Sketch"
      },
      {
        "command": "arduinoMcp.verify",
        "title": "Arduino Grease: Verify Sketch"
      },
      {
        "command": "arduinoMcp.upload",
        "title": "Arduino Grease: Upload Sketch"
      },
      {
        "command": "arduinoMcp.serverStatus",
        "title": "Arduino Grease: Server Status"
      },
      {
        "command": "arduinoMcp.refreshServer",
        "title": "Arduino Grease: Refresh Server"
      },
      {
        "command": "arduinoMcp.refreshPortsBoards",
        "title": "Arduino Grease: Refresh Ports/Boards"
      },
      {
        "command": "arduinoMcp.startServer",
        "title": "Arduino Grease: Start Server"
      },
      {
        "command": "arduinoMcp.stopServer",
        "title": "Arduino Grease: Stop Server"
      },
      {
        "command": "arduinoMcp.toggleServer",
        "title": "Arduino Grease: Toggle Server"
      },
      {
        "command": "arduinoMcp.installCore",
        "title": "Arduino Grease: Install Board Core"
      },
      {
        "command": "arduinoMcp.selectTarget",
        "title": "Arduino Grease: Select Board/Port"
      },
      {
        "command": "arduinoMcp.openSerialMonitor",
        "title": "Arduino Grease: Open Serial Monitor"
      },
      {
        "command": "arduinoMcp.serialCommand",
        "title": "Arduino Grease: Serial Command"
      },
      {
        "command": "arduinoMcp.openSerialPlotter",
        "title": "Arduino Grease: Open Serial Plotter"
      },
      {
        "command": "arduinoMcp.openExamples",
        "title": "Arduino Grease: Open Examples"
      },
      {
        "command": "arduinoMcp.openBoardTemplate",
        "title": "Arduino Grease: Open AI Prompt Template"
      },
      {
        "command": "arduinoMcp.cycleAccentColor",
        "title": "Arduino Grease: Cycle Accent Color"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arduinoMcp",
          "title": "Arduino Grease",
          "icon": "resources/activity/arduino-mcp.svg"
        }
      ]
    },
    "views": {
      "arduinoMcp": [
        {
          "id": "arduinoMcp.toolbar",
          "name": "",
          "type": "webview",
          "icon": "resources/activity/arduino-mcp.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "arduinoMcp.upload",
        "key": "F5",
        "when": "editorTextFocus && resourceExtname == .ino"
      },
      {
        "command": "arduinoMcp.upload",
        "key": "shift+enter",
        "mac": "shift+enter",
        "when": "editorTextFocus && resourceExtname == .ino"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.105.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/express": "^2.0.0-alpha.2",
    "@modelcontextprotocol/node": "^2.0.0-alpha.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "express": "^5.2.1"
  },
  "repository": {
    "type": "git",
    "url": ""
  }
}
