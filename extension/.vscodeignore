# Everything is bundled by esbuild into dist/extension.js and dist/server.mjs.
# No native .node files remain — serialport and usb have been replaced by
# arduino-cli subprocesses, so the entire node_modules directory can be excluded.
node_modules/**

# Exclude dev/build artifacts not needed at runtime
.DS_Store
package-lock.json
dist/extension.js.map

# server/ source is bundled into dist/server.mjs — exclude originals
server/**
scripts/**

# src/ source is bundled into dist/extension.js — exclude originals
src/**
tsconfig.json
out/**
