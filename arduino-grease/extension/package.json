{
  "name": "arduino-grease",
  "displayName": "Arduino Grease",
  "publisher": "RobotFab",
  "version": "0.2.1",
  "description": "Arduino tooling + MCP server for agentic debugging inside VS Code, Cursor, and Antigravity. This package was developed by Andre Rosendo.",
  "main": "dist/extension.js",
  "icon": "icon.png",
  "scripts": {
    "compile": "tsc -p .",
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "lint": "eslint .",
    "package": "npm run build && npx @vscode/vsce package --allow-missing-repository"
  },
  "keywords": [],
  "author": "Andre Rosendo",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:arduinoMcp.toolbar",
    "onCommand:arduinoMcp.serverStatus",
    "onCommand:arduinoMcp.refreshServer",
    "onCommand:arduinoMcp.refreshPortsBoards",
    "onCommand:arduinoMcp.startSketch",
    "onCommand:arduinoMcp.installCore",
    "onCommand:arduinoMcp.verify",
    "onCommand:arduinoMcp.upload",
    "onCommand:arduinoMcp.selectTarget",
    "onCommand:arduinoMcp.openSerialMonitor",
    "onCommand:arduinoMcp.serialCommand",
    "onCommand:arduinoMcp.openSerialPlotter",
    "onCommand:arduinoMcp.openExamples",
    "onCommand:arduinoMcp.openManagers",
    "onCommand:arduinoMcp.openBoardTemplate"
  ],
  "contributes": {
    "commands": [
      {
        "command": "arduinoMcp.startSketch",
        "title": "Arduino Grease: Start Sketch"
      },
      {
        "command": "arduinoMcp.verify",
        "title": "Arduino Grease: Verify Sketch"
      },
      {
        "command": "arduinoMcp.upload",
        "title": "Arduino Grease: Upload Sketch"
      },
      {
        "command": "arduinoMcp.serverStatus",
        "title": "Arduino Grease: Server Status"
      },
      {
        "command": "arduinoMcp.refreshServer",
        "title": "Arduino Grease: Refresh Server"
      },
      {
        "command": "arduinoMcp.refreshPortsBoards",
        "title": "Arduino Grease: Refresh Ports/Boards"
      },
      {
        "command": "arduinoMcp.startServer",
        "title": "Arduino Grease: Start Server"
      },
      {
        "command": "arduinoMcp.stopServer",
        "title": "Arduino Grease: Stop Server"
      },
      {
        "command": "arduinoMcp.toggleServer",
        "title": "Arduino Grease: Toggle Server"
      },
      {
        "command": "arduinoMcp.installCore",
        "title": "Arduino Grease: Install Board Core"
      },
      {
        "command": "arduinoMcp.selectTarget",
        "title": "Arduino Grease: Select Board/Port"
      },
      {
        "command": "arduinoMcp.openSerialMonitor",
        "title": "Arduino Grease: Open Serial Monitor"
      },
      {
        "command": "arduinoMcp.serialCommand",
        "title": "Arduino Grease: Serial Command"
      },
      {
        "command": "arduinoMcp.openSerialPlotter",
        "title": "Arduino Grease: Open Serial Plotter"
      },
      {
        "command": "arduinoMcp.openExamples",
        "title": "Arduino Grease: Open Examples"
      },
      {
        "command": "arduinoMcp.openManagers",
        "title": "Arduino Grease: Open Managers"
      },
      {
        "command": "arduinoMcp.openBoardTemplate",
        "title": "Arduino Grease: Open AI Prompt Template"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arduinoMcp",
          "title": "Arduino Grease",
          "icon": "resources/activity/arduino-mcp.svg"
        }
      ]
    },
    "views": {
      "arduinoMcp": [
        {
          "id": "arduinoMcp.toolbar",
          "name": "Grease",
          "type": "webview",
          "icon": "resources/activity/arduino-mcp.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "arduinoMcp.upload",
        "key": "F5",
        "when": "editorLangId == cpp || resourceExtname == .ino"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/express": "^2.0.0-alpha.2",
    "@modelcontextprotocol/node": "^2.0.0-alpha.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "express": "^5.2.1",
    "serialport": "^13.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  }
}
